# ==============================================================================
# FarmDoctor AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root:
#   copy .env.example .env
# Fill in your configuration values below. Never commit real '.env' to Git!

# ------------------------------------------------------------------------------
# 1. LIVE WEATHER SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Provider options: 'openweathermap' or 'weatherapi'
WEATHER_PROVIDER=openweathermap

# OpenWeatherMap API Key (Free tier available at: https://openweathermap.org/api)
# WeatherAPI Key (Free tier available at: https://www.weatherapi.com/)
WEATHER_API_KEY=your_weather_api_key_here

# Default fallback farm location when coordinates are not provided
WEATHER_DEFAULT_CITY=Nagpur,IN

# ------------------------------------------------------------------------------
# 2. OPTIONAL LLM INTEGRATION (For narrative advisory enhancement)
# ------------------------------------------------------------------------------
# Optional: The advisory agent works 100% offline out-of-the-box using the verified
# local agricultural knowledge base. If you wish to enable LLM narrative summaries:
# Provider options: 'gemini', 'openai', or leave blank for offline mode.
LLM_PROVIDER=
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 3. FASTAPI BACKEND & PERSISTENT DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MODEL_CHECKPOINT_PATH=models/farmdoctor_efficientnet_b0.pth
CLASS_NAMES_PATH=models/class_names.json

# SQLite Persistent Database Location (stores Users, Farms, Scans, Assistant History)
DATABASE_PATH=backend/data/farmdoctor.db

# Upload directory for leaf scans
UPLOADS_DIR=backend/uploads

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (For Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
